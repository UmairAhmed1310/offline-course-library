{
  "name": "offline-course-library",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first course library — test harness only, no runtime deps",
  "type": "module",
  "scripts": {
    "test": "node --test test/unit/*.test.js && npm run test:contrast",
    "test:contrast": "node test/contrast.cjs",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "serve": "npx serve . -l 8080",
    "lint": "echo 'no linter configured'"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "playwright": "^1.44.0",
    "serve": "^14.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}